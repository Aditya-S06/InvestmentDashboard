# Supabase (cloud Postgres) — preferred for local/dev without Docker
# Dashboard → Project Settings → Database → copy password, then run:
#   .\scripts\link-supabase.ps1
#
# After migration, run security:harden-db, security:verify-identity, then security:activate-db.
# Initial provisioning accepts the operator URLs here and moves them to .env.migrations.
# Keep that operator file out of the running app's deployment environment.
DATABASE_URL="postgresql://oracle_runtime.YOUR_PROJECT_REF:[RUNTIME-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3"
AUTH_DATABASE_URL="postgresql://oracle_identity.YOUR_PROJECT_REF:[IDENTITY-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3"
# Restricted runtime URL too. Privileged DIRECT_URL belongs only in .env.migrations.
DIRECT_URL="postgresql://oracle_runtime.YOUR_PROJECT_REF:[RUNTIME-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3"

SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Optional public anon key (only if you add a Supabase JS client later)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Required for NextAuth sessions. Production refuses missing/placeholder values.
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
# CSP starts report-only; inspect browser violations before enabling enforcement.
CSP_ENFORCE="false"
# All instances must share these keys. Run npm run security:init-key on the operator host.
# Store separately from database backups; never put them in NEXT_PUBLIC_* variables.
API_KEY_ENCRYPTION_ACTIVE_KEY_ID=""
API_KEY_ENCRYPTION_KEYS='{}'
# Set true only when a reverse proxy overwrites X-Forwarded-For. Vercel is trusted automatically.
TRUST_PROXY="false"

# Open registration is off by default.
ALLOW_PUBLIC_SIGNUP="false"
# Opt in with true only for local demo use. Remove any existing demo account
# before exposing this host; false skips creation but does not delete it.
SEED_DEMO_USER="false"

# AI Insights (OpenRouter)
OPENROUTER_API_KEY=""
ADMIN_EMAILS="your-admin@example.com"
# Authoritative allowlist: empty/unset grants no admin access, regardless of stored roles.

# Trading Desk: configure the Next parent, NOT TradingAgents/.env.
# Access/key source is shared with Insights; no separate Desk key.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
DESK_DEEP_MODEL="deepseek/deepseek-v4-pro"
DESK_QUICK_MODEL="google/gemini-3.5-flash"
# Parent-only path; use a persistent private directory in production.
DESK_DATA_ROOT=".data/desk"
# Weighted units per user/hour in each Node process: fast=1, standard=2, deep=3.
DESK_RATE_LIMIT_PER_HOUR="4"
# Optional settings forwarded explicitly to TradingAgents (upstream defaults if unset):
# TRADINGAGENTS_OUTPUT_LANGUAGE="English"
# TRADINGAGENTS_BENCHMARK_TICKER="SPY"
# TRADINGAGENTS_TEMPERATURE="0.0"
# TRADINGAGENTS_LLM_MAX_RETRIES="3"
# TRADINGAGENTS_MAX_TOKENS="4096"
# FRED_API_KEY=""

# YouTube Analysis (Data API v3 + ingest)
YOUTUBE_API_KEY=""
YOUTUBE_CHANNELS_FILE="conf/youtube_channels.json"
YOUTUBE_POLL_SINCE_DAYS="2"
YOUTUBE_CACHE_DIR="data"
YOUTUBE_RATE_LIMIT_PER_MIN="30"
# Optional override for summarization model (defaults to deepseek/deepseek-chat with fallbacks)
# YOUTUBE_SUMMARY_MODEL="deepseek/deepseek-chat"

# Webull OpenAPI (admin broker + hybrid quotes; never commit real keys)
WEBULL_APP_KEY=""
WEBULL_APP_SECRET=""
# Env-specific pairs (preferred). Fallback is WEBULL_APP_KEY / WEBULL_APP_SECRET.
# WEBULL_APP_KEY_SANDBOX=""
# WEBULL_APP_SECRET_SANDBOX=""
# WEBULL_APP_KEY_PROD=""
# WEBULL_APP_SECRET_PROD=""
WEBULL_REGION_ID="us"
# sandbox | prod — anything other than prod/production/live is treated as sandbox
WEBULL_ENVIRONMENT="sandbox"
WEBULL_RATE_LIMIT_PER_MIN="30"
WEBULL_TOKEN_DIR="conf"
# Trading (all default-safe). Separate from local /dashboard/paper simulation.
WEBULL_TRADING_ENABLED="false"
WEBULL_LIVE_TRADING_ENABLED="false"
WEBULL_MAX_NOTIONAL_USD="5000"
WEBULL_MAX_QTY="100"

# Optional local Docker Postgres (only if you are NOT using Supabase)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/market_intel"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/market_intel"
