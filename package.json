{
  "name": "app",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:up": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/docker-up.ps1",
    "db:down": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/docker-down.ps1",
    "db:link": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/link-supabase.ps1",
    "db:push": "node --require dotenv/config node_modules/prisma/build/index.js db push",
    "db:seed": "node --require dotenv/config node_modules/prisma/build/index.js db seed",
    "test": "vitest run --configLoader runner",
    "setup": "node scripts/setup-database.cjs",
    "security:init-key": "node scripts/init-key-encryption.cjs",
    "security:encrypt-keys": "tsx --require ./scripts/operator-env.cjs scripts/encrypt-api-keys.ts",
    "security:harden-db": "node scripts/harden-database.cjs",
    "security:verify-identity": "tsx scripts/verify-identity-db.ts",
    "security:activate-db": "node scripts/harden-database.cjs --activate",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.31",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.23.15",
    "typescript": ">=5.2.2 <6.1.0",
    "vite": "^8.0.0",
    "vitest": "5.0.5",
    "@tailwindcss/postcss": "4.3.3"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@openrouter/sdk": "1.5.5",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.9",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "next-auth": "4.24.15",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "2.0.8",
    "zod": "4.6.7",
    "@prisma/adapter-pg": "7.10.1"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
