{
  "name": "app",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:up": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/docker-up.ps1",
    "db:down": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/docker-down.ps1",
    "db:link": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/link-supabase.ps1",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "setup": "prisma generate && prisma db push && prisma db seed"
  },
  "prisma": {
    "seed": "tsx --require dotenv/config scripts/safe-seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.6.2",
    "@types/react": "18.2.22",
    "@types/react-dom": "18.2.7",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.24.0",
    "eslint-config-next": "14.2.28",
    "eslint-plugin-react-hooks": "4.6.0",
    "postcss": "8.4.30",
    "prisma": "6.7.0",
    "tailwindcss": "3.3.3",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.20.3",
    "typescript": "5.2.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@openrouter/sdk": "^0.12.79",
    "@prisma/client": "6.7.0",
    "autoprefixer": "10.4.15",
    "bcryptjs": "2.4.3",
    "dotenv": "16.5.0",
    "lucide-react": "0.446.0",
    "next": "14.2.28",
    "next-auth": "4.24.11",
    "next-themes": "0.3.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "2.15.3",
    "remark-gfm": "^4.0.1",
    "sonner": "1.5.0",
    "zod": "3.23.8"
  },
  "browserslist": [
    "ie >= 11",
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
